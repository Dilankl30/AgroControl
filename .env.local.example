# Copia este archivo a .env.local y completa los valores del proyecto Supabase.
# Usa la clave publishable/anon del cliente; nunca pongas service_role aquí.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Solo servidor (no exponer al cliente). Clave service_role de Supabase.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# SMTP requerido para entregar códigos de verificación por correo
SMTP_HOST=smtp.tu-proveedor.com
SMTP_PORT=587
SMTP_USER=tu-usuario-smtp
SMTP_PASS=tu-password-smtp
SMTP_FROM="AgroControl <no-reply@tu-dominio.com>"
